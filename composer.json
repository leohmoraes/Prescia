{
  "name": "leohmoraes/prescia",
  "description": "Prescia framework",
  "type": "project",
  "require": {
    "php": ">=8.3 <8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Prescia\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "migrate:php83": "php tools/migrate_php83.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
